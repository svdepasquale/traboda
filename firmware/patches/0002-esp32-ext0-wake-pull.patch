diff --git a/ports/esp32/modmachine.c b/ports/esp32/modmachine.c
index 5fb9bf8..72178b5 100644
--- a/ports/esp32/modmachine.c
+++ b/ports/esp32/modmachine.c
@@ -35,6 +35,9 @@
 #include "esp_mac.h"
 #include "esp_sleep.h"
 #include "esp_pm.h"
+#if MICROPY_HW_SLEEP_WAKE_PULL
+#include "driver/rtc_io.h"
+#endif
 
 #include "py/objtuple.h"
 #include "modmachine.h"
@@ -149,6 +152,17 @@ static void machine_sleep_helper(wake_type_t wake_type, size_t n_args, const mp_
     #if SOC_PM_SUPPORT_EXT0_WAKEUP
     if (machine_rtc_config.ext0_pin != -1 && (machine_rtc_config.ext0_wake_types & wake_type)) {
         esp_sleep_enable_ext0_wakeup(machine_rtc_config.ext0_pin, machine_rtc_config.ext0_level ? 1 : 0);
+        #if MICROPY_HW_SLEEP_WAKE_PULL
+        // Once the pad moves to the RTC mux its digital pull no longer applies: give an
+        // open-drain wake line (an I/O expander's INT, say) the RTC pull of its idle level.
+        if (machine_rtc_config.ext0_level) {
+            rtc_gpio_pullup_dis(machine_rtc_config.ext0_pin);
+            rtc_gpio_pulldown_en(machine_rtc_config.ext0_pin);
+        } else {
+            rtc_gpio_pulldown_dis(machine_rtc_config.ext0_pin);
+            rtc_gpio_pullup_en(machine_rtc_config.ext0_pin);
+        }
+        #endif
     }
     #endif
 
